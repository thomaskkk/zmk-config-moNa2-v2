#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100
#define MOUSE 5
#define SCROLL 6

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&lt {
    quick-tap-ms = <300>;
    flavor = "balanced";
};

/ {
    combos {
        compatible = "zmk,combos";

        layer4_ESC {
            bindings = <&lt 0 ESC>;
            key-positions = <39 38>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        spacedqt: spacedqt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DQT &kp SPACE>;
            label = "SPACEDQT";
        };

        spacesqt: spacesqt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SQT &kp SPACE>;
            label = "SPACESQT";
        };

        spacetilde: spacetilde {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp TILDE &kp SPACE>;
            label = "SPACETILDE";
        };

        spacecaret: spacecaret {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp CARET &kp SPACE>;
            label = "SPACECARET";
        };

        spacegrave: spacegrave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp GRAVE &kp SPACE>;
            label = "SPACEGRAVE";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        scroll_up_down: mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>;
        };

        scroll_right_left: mouse_wheel_right_left {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Colemak {
            bindings = <
&kp Q           &kp W       &kp F        &kp P             &kp G                                                         &kp J        &kp L              &kp U        &kp Y       &kp SEMICOLON
&mt LEFT_WIN A  &mt LALT R  &mt LCTRL S  &mt LEFT_SHIFT T  &kp D                              &kp F13                    &kp H        &mt RIGHT_SHIFT N  &mt RCTRL E  &mt RALT I  &mt RGUI O
&kp Z           &kp X       &kp C        &kp V             &kp B      &kp F14                 &kp F15                    &kp K        &kp M              &kp COMMA    &kp DOT     &kp SLASH
&kp ESC         &mkp MB3    &mkp MB2     &mkp MB1          &lt 1 TAB  &mt LEFT_SHIFT SPACE    &mt RIGHT_SHIFT BACKSPACE  &lt 2 ENTER                                              &lt 3 DEL
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        Navigation {
            bindings = <
&kp NUMBER_1  &kp NUMBER_2  &kp UP_ARROW  &kp NUMBER_4  &kp NUMBER_5                     &kp PLUS    &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp ASTERISK
&kp HOME      &kp LEFT      &kp DOWN      &kp RIGHT     &kp PAGE_UP              &trans  &kp MINUS   &kp N4        &kp N5        &kp N6        &kp SLASH
&kp END       &kp PSCRN     &kp C_AL_CAL  &kp INS       &kp PAGE_DOWN  &trans    &trans  &kp PERIOD  &kp N1        &kp N2        &kp N3        &kp ENTER
&trans        &trans        &trans        &trans        &trans         &trans    &trans  &kp N0                                                &trans
            >;

            sensor-bindings = <&scroll_right_left>;
        };

        Symbols {
            bindings = <
&kp EXCL     &kp AT       &kp HASH     &kp DOLLAR  &kp PERCENT                       &kp CARET          &kp AMPERSAND     &kp ASTERISK      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&spacegrave  &spacecaret  &spacetilde  &spacesqt   &trans                    &trans  &kp DOUBLE_QUOTES  &kp SINGLE_QUOTE  &kp TILDE         &kp CARET             &kp GRAVE
&kp PIPE     &kp EQUAL    &kp PLUS     &kp MINUS   &kp UNDER    &spacedqt    &trans  &kp LEFT_BRACE     &kp RIGHT_BRACE   &kp LEFT_BRACKET  &kp RIGHT_BRACKET     &kp BACKSLASH
&trans       &trans       &trans       &trans      &trans       &kp SPACE    &trans  &trans                                                                       &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        Function {
            bindings = <
&kp F1   &kp F2          &kp F3    &kp F4   &kp F5                           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&kp F6   &kp F7          &kp F8    &kp F9   &kp F10            &kp C_VOL_UP  &trans        &trans        &trans        &trans        &bt BT_CLR
&kp INS  &kp SCROLLLOCK  &kp CAPS  &kp F11  &kp F12  &trans    &kp C_VOL_DN  &kp C_MUTE    &kp C_PREV    &kp C_NEXT    &kp C_PP      &trans
&trans   &trans          &trans    &trans   &trans   &trans    &trans        &trans                                                  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans    &trans    &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans            &trans    &mkp MB3  &mkp MB1  &mkp MB2  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans    &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &mkp MB4  &mkp MB5                              &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };
    };
};
